{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://originagent.local/evolution-chain/external-validator-artifact.schema.json",
  "title": "ExternalValidatorArtifact",
  "type": "object",
  "required": [
    "schema_version",
    "module_digest",
    "validator",
    "operator_group_hash",
    "runner_fingerprint_hash",
    "tool_tests_hash",
    "result_digest",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "originagent.evolution.external_validator_artifact.v1" },
    "module_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "validator": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "operator_group_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runner_fingerprint_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool_tests_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
