{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://originagent.local/evolution-chain/evidence-report.schema.json",
  "title": "EvidenceReport",
  "type": "object",
  "required": [
    "schema_version",
    "module_digest",
    "proof_bundle_hash",
    "report_hash",
    "evidence_type",
    "reporter",
    "operator_group_hash",
    "runner_fingerprint_hash",
    "challenge_window_end",
    "report_status",
    "testnet_only"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "originagent.evolution.evidence_report.v1" },
    "module_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proof_bundle_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "report_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_type": {
      "enum": [
        "local_client_report",
        "user_signed_receipt",
        "validator_report",
        "unqualified_validator_report",
        "foundation_seed_report"
      ]
    },
    "reporter": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "operator_group_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runner_fingerprint_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "challenge_window_end": { "type": "integer", "minimum": 0 },
    "report_status": { "enum": ["active", "invalidated"] },
    "testnet_only": { "const": true },
    "external_validator_artifact_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
