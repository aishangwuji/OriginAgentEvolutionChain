{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://originagent.local/evolution-chain/challenge-record.schema.json",
  "title": "ChallengeRecord",
  "type": "object",
  "required": [
    "schema_version",
    "challenge_id",
    "evidence_id",
    "module_digest",
    "reason_hash",
    "challenger",
    "created_at",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "originagent.evolution.challenge_record.v1" },
    "challenge_id": { "type": "string", "pattern": "^(0x)?[0-9a-fA-F]{64}$" },
    "evidence_id": { "type": "string", "pattern": "^(0x)?[0-9a-fA-F]{64}$" },
    "module_digest": { "type": "string", "pattern": "^(0x)?[0-9a-fA-F]{64}$" },
    "reason_hash": { "type": "string", "pattern": "^(0x)?[0-9a-fA-F]{64}$" },
    "challenger": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "created_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["submitted", "upheld", "rejected"] },
    "reporter": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "resolution_hash": { "type": "string", "pattern": "^(0x)?[0-9a-fA-F]{64}$" },
    "resolved_at": { "type": "string", "minLength": 1 }
  }
}
